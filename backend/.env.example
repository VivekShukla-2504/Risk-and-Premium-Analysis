# Copy to .env (never commit .env)
DATA_PATH=data/InsuranceData.csv
CLEANED_DATA_PATH=data/cleaned_insurance_data.csv
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional YYYY-MM-DD "as-of" date for the earned-premium proxy. Blank = latest ClaimDate in data.
VALUATION_DATE=
# auto = use MongoDB if MONGODB_URI is set and reachable, otherwise the CSV. csv = never use MongoDB.
DATA_SOURCE=auto
MONGODB_URI=
MONGODB_DB=insurance_analytics
MONGODB_COLLECTION=policies
